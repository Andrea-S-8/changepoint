library("changepoint")
set.seed(123)
n <- 200
# AR(1)-like structure with a break
x <- numeric(n)
for (t in 2:n) {
noise <- rnorm(1)
if (t < 100) {
x[t] <- 0.6 * x[t-1] + noise
} else {
x[t] <- 0.6 * x[t-1] + 3 + noise  # mean shift at 100
}
}
plot(x, type = "l")
abline(v = 100, col = "red")
cpt <- cpt.regAR(x)
library("changepoint")
set.seed(123)
n <- 200
# AR(1)-like structure with a break
x <- numeric(n)
for (t in 2:n) {
noise <- rnorm(1)
if (t < 100) {
x[t] <- 0.6 * x[t-1] + noise
} else {
x[t] <- 0.6 * x[t-1] + 3 + noise  # mean shift at 100
}
}
plot(x, type = "l")
abline(v = 100, col = "red")
cpt <- cpt.regAR(x)
devtools::load_all()
devtools::check()
rlang::last_trace()
devtools::check(error_on = "never")
rlang::last_trace()
system("git remote -v")
system("git status")
packageVersion("devtools")
packageVersion("pkgload")
packageVersion("roxygen2")
R.version.string
