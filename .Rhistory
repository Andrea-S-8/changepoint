usethis::use_git()
### Code to check that C_cptregAR.c and C_cptreg.c from EnvCpt
### are doing the same thing.
n=4000
lastn=n-floor(n*0.24)-floor(n*0.28)-floor(n*0.32)
intercept = c(rep(0.976,floor(n*0.24)), rep(-9.376, floor(n*0.28)),rep(-8.686,floor(n*0.32)),rep(-84.26,lastn))
linear=c(rep(0.039,floor(n*0.24)), rep(0.124, floor(n*0.28)),rep(0.097,floor(n*0.32)),rep(0.293,lastn))
quadratic=c(rep(0.000205,floor(n*0.24)), rep(0.0000124, floor(n*0.28)),rep(0.0000613,floor(n*0.32)),rep(-0.0000617,lastn))
phi=0#.714
sd=sqrt(0.08)
set.seed(37980)
#y=arima.sim(model=list(ar=phi),n=n,sd=sd)#
y=rnorm(n,sd=sd)#
y=y+intercept+linear*1:n + quadratic*(1:n)^2
tcpt=c(floor(n*0.24),floor(n*0.24)+floor(n*0.28),floor(n*0.24)+floor(n*0.28)+floor(n*0.32))
design=matrix(c(rep(1,n),1:n, c(1:n)^2),ncol=3)
library(changepoint)
out=cpt.reg1(cbind(y,design),method="PELT",minseglen=60,penalty="Manual",pen.value=5*log(n))
